# ── Visual editor (/build) ────────────────────────────────────────────────
# HTTP Basic Auth gate for /build and /api/puck. Required in production —
# without these the editor is unprotected on a deployed environment, so the
# middleware fails CLOSED there. In local dev (next dev) it fails OPEN, so you
# can leave them empty while developing.
EDITOR_USER=
EDITOR_PASSWORD=

# ── Git-based persistence ─────────────────────────────────────────────────
# When set, saving in the editor commits content/puck/<slug>.json to GitHub
# via the REST Contents API → Vercel auto-redeploys. Without a token, saving
# falls back to a local filesystem write (fine for `next dev`, but a no-op on
# Vercel's read-only runtime).
#
# Token: fine-grained PAT with "Contents: Read and write" on this repo, or a
# classic PAT with the `repo` scope.
GITHUB_TOKEN=

# Optional overrides (defaults shown). GITHUB_COMMIT_BRANCH falls back to the
# Vercel deployment branch (VERCEL_GIT_COMMIT_REF), then "main".
GITHUB_OWNER=alexbeuwy
GITHUB_REPO=beuwy-relaunch
GITHUB_COMMIT_BRANCH=
